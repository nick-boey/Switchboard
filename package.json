{
  "name": "switchboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write ."
  },
  "//": "pnpm build-script approvals live in pnpm-workspace.yaml (allowBuilds) for pnpm 11+.",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@switchboard/shared": "workspace:*",
    "@playwright/test": "1.61.0",
    "@types/node": "26.0.0",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.6.0",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vitest": "4.1.9"
  }
}
