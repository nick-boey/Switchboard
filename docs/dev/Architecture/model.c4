// Switchboard architecture — the permanent base model (foundations).
//
// Element ids are FIXED by foundations design Decision 9 / plan.md "Planned
// architecture": the system `Switchboard` with containers `Switchboard.WebSPA`,
// `Switchboard.Api`, `Switchboard.Cli`, and the externals `GitHub`, `TmuxHost`,
// `ClaudeBackplane`, `Tailscale`, `MobileApp`. Later changes `extend` these and add
// `Planned/<change>.c4` `#todo` overlays — do not rename them.

model {

  Switchboard = system 'Switchboard' {
    description 'Mobile-first web app for remote-controlling Claude Code sessions, reachable only over Tailscale.'

    WebSPA = container 'Web SPA' {
      description 'React + Vite + Mantine single-page app (retro switchboard theme). Calls the API through the typed Hono RPC client via TanStack Query.'
      technology 'React, Vite, Mantine, TanStack Query'
    }

    Api = container 'API Server' {
      description 'Hono server exposed programmatically via start(ctx: RuntimeContext). Loopback-bound behind a reject-by-default auth gate (Tailscale identity + bearer fallback), with /health and OpenTelemetry redaction.'
      technology 'Hono, Zod, OpenTelemetry'

      // Components built by repo-clone-browse (graduated from Planned/repo-clone-browse.c4).
      githubService = component 'GitHub Service' {
        description 'Lists the authenticated account, organisations, and accessible repositories via PAT-authenticated GitHub REST, behind an OAuth-ready provider interface. Maps failures to typed errors without leaking GitHub error bodies.'
        technology 'fetch, Zod'
      }

      gitService = component 'Git Service' {
        description 'Bare-clones a validated <owner>/<repo> to ~/.switchboard/repos/<owner>/<repo>/.bare via the git CLI (plain HTTPS URL, no embedded credentials) and lists completed clones from disk.'
        technology 'git CLI, child_process'
      }

      operationLedger = component 'Operation Ledger + Lock' {
        description 'Filesystem-backed operation records + per-key lock under ~/.switchboard: idempotency, serialization, abort/cancellation as a single terminal transition, and restart recovery. Reused by later long-running work.'
        technology 'Node fs'
      }

      credentialHelper = component 'Credential Helper' {
        description "Supplies the PAT to git over the credential protocol from a 600-mode token file in ~/.switchboard, wired per-invocation with host-scoped -c so it is never persisted into the cloned bare config."
        technology 'git credential protocol'
      }

      // Internal wiring (component-level).
      gitService -> operationLedger 'Runs each clone as a tracked operation'
      gitService -> credentialHelper 'Obtains the PAT over the git credential protocol'

      // Realises the base model's #planned `Switchboard.Api -> GitHub` at the component level.
      githubService -> GitHub 'Lists repositories and organisations (PAT-authenticated REST)'
      gitService -> GitHub 'Bare-clones the chosen repository over HTTPS'

      // Component built by worktree-management (graduated from Planned/worktree-management.c4).
      worktreeService = component 'Worktree Service' {
        description 'Extends the Git service with worktree create/list/delete at repos/<owner>/<repo>/worktrees/<wt-id> on the canonical path-safe id scheme (slug--hash). Distinguishes an existing-remote branch from a new branch, derives per-worktree git status (the git lamp), enforces a server-side safe-to-delete re-check, and performs mandatory create-time collision detect-and-reject.'
        technology 'git CLI, child_process'
      }

      worktreeService -> gitService 'Operates inside the existing bare clone (bareDir, completion marker)'
      worktreeService -> operationLedger 'Runs each create as a worktree-typed tracked operation; serializes git mutations under a per-repo lock'
      worktreeService -> credentialHelper 'Supplies the PAT for an existing-remote fetch over the git credential protocol'
      worktreeService -> GitHub 'Fetches an existing remote branch over HTTPS'

      // Components built by claude-session-launch (graduated from Planned/claude-session-launch.c4).
      sessionService = component 'Session Service' {
        description 'Launches claude --remote-control DETACHED in a tmux session rooted at the worktree, tracked as a session-typed operation (keyed session/<repo-id>/<wt-id>, distinct from the worktree-create key) for idempotency + the transient starting state. Stops a session by killing its tmux session; launch and stop serialize on one per-session lock via a drain-then-lock loop. Lists existence + worktree mapping only — liveness is always re-derived from tmux.'
        technology 'tmux CLI, child_process'
      }

      sessionProbe = component 'Session Liveness Probe' {
        description 'Tmux-backed liveness: hasActiveSession(repoId, wtId) forward-derives the path-safe tmux session name (slug--hash, sb- prefix) from (repo-id, wt-id) and tests tmux existence — never decoding a name. Depends ONLY on tmux + the derived name (no worktree back-dependency), so wiring it into the worktree safe-to-delete seam introduces no cycle.'
        technology 'tmux CLI'
      }

      sessionService -> operationLedger 'Runs each launch as a session-typed tracked operation; serializes launch/stop on one per-session lock'
      sessionService -> worktreeService 'Obtains the worktree path for launch and the existing-worktree candidate set for listing'
      sessionService -> sessionProbe 'Derives session liveness for the per-repo listing'

      // Cross-change seam: the worktree safe-to-delete predicate reads liveness from the tmux-only
      // probe — the ONLY worktree->session edge, pointing at the probe (no back-edge), so no cycle.
      worktreeService -> sessionProbe 'Reads tmux-backed session liveness for the safe-to-delete predicate (the hasActiveSession seam)'

      // Realises the base model's #planned `Switchboard.Api -> TmuxHost` at the component level.
      sessionService -> TmuxHost 'Launches claude --remote-control detached in a tmux session (argv, no shell) and kills it on stop'
      sessionProbe -> TmuxHost 'Tests tmux session existence by forward-deriving the session name'

      // Component built by link-claude-code-online (graduated from Planned/link-claude-code-online.c4).
      // This description carries the PERMANENT record of the ~/.claude/sessions/<pid>.json dependency
      // + the bounded, observable-degradation contract (docs-migration.md).
      sessionLinkResolver = component 'Session Web-Link Resolver' {
        description "PURE resolver of a live session's CLOUD bridge session id for the claude.ai/code deep link. Takes the launch-assigned session UUID as INPUT (sessionService reads it from the operation ledger and passes it in — the resolver itself has no ledger dependency). Builds ONE bounded index per poll over claude's per-session state files (~/.claude/sessions/<pid>.json), bounded to the newest N entries by mtime within a deadline, looks up the entry by that UUID, and returns its bridgeSessionId only if it matches the strict /^session_[A-Za-z0-9]+$/ token shape. The state file is undocumented internal Claude Code state, so each file is Zod-validated with a TOLERANT schema: an unknown/additive field is ignored and the session still resolves (no telemetry). The resolver degrades to NO link WITH structured telemetry only on a BREAKING change — a missing/invalid required field, a malformed bridgeSessionId token, a parse/size failure, or hitting the scan bound — so a breaking format change is observable rather than a silent UI absence. The format knowledge is contained here alone; the read is never load-bearing for liveness."
        technology 'Node fs, Zod'
      }

      // sessionService owns the ledger lookup: it reads each live session's recorded launch UUID via
      // its existing `-> operationLedger` edge and passes it into the pure resolver, so no
      // resolver -> operationLedger edge exists (the boundary stays narrow).
      sessionService -> sessionLinkResolver 'Passes each live session''s recorded launch UUID (read from the operation ledger) to the pure resolver and collects its bridge id for the per-repo listing'

      // The new read: the resolver reads the bridge id from the state file the `claude` process
      // maintains on the host (the TmuxHost domain), matched by the launch-assigned session UUID.
      sessionLinkResolver -> TmuxHost "Reads the cloud bridge session id from claude's per-session state file (~/.claude/sessions/<pid>.json), matched by the launch-assigned session UUID"
    }

    Cli = container 'CLI' {
      description 'The `switchboard` bin: builds a RuntimeContext, supervises the server start(ctx) for a local run, and runs the `--docker` in-container bring-up of userspace tailscaled + the pinned `tailscale serve`.'
      technology 'TypeScript, tsup'

      // Components built by runtime-cli-docker (graduated from Planned/runtime-cli-docker.c4).
      configBootstrap = component 'Config Bootstrap' {
        description 'The runtime provisioning front door: wraps loadConfig() (config.json 600, run/ + secrets/ dirs 700) idempotently and enforces the mode-aware cross-field rule — trustServeIdentity + a serve ingress is rejected unless the runtime asserts no host publication (--docker) — failing fast before any listener binds. Mode is a bootstrap input; the shared schema stays mode-agnostic.'
        technology 'TypeScript, Zod'
      }

      serverSupervisor = component 'Server Supervisor' {
        description 'Supervises the imported server start(ctx): SIGINT/SIGTERM -> graceful close releasing every ingress (no restart); an unexpected stop (rejected start or whenClosed settling) -> bounded exponential backoff restart, giving up non-zero past a ceiling so a fault is surfaced rather than crash-looped.'
        technology 'TypeScript'
      }

      dockerBringUp = component 'Docker Bring-up' {
        description 'The in-container supervisor (start --docker): asserts Tailscale >= v1.50.0, starts userspace tailscaled (no NET_ADMIN/TUN), tailscale up from the mounted auth-key secret, starts the server on the dedicated loopback serve ingress, then runs the pinned `tailscale serve --bg --https=443 http://127.0.0.1:<servePort>`. Supervises tailscaled as a child and forwards shutdown signals to it. All bring-up steps go through an injectable runner so the wiring is testable without real Docker/Tailscale.'
        technology 'TypeScript, child_process'
      }

      // Bootstrap feeds the supervised local run and the docker bring-up.
      serverSupervisor -> configBootstrap 'Runs the bootstrapped, validated config + no-host-publication assertion'
      dockerBringUp -> configBootstrap 'Bootstraps with assertNoHostPublication=true (container isolation)'
      // The docker bring-up reuses the same server supervisor for start(ctx).
      dockerBringUp -> serverSupervisor 'Reuses the supervisor for the server on the dedicated serve ingress'

      // Realises the base model's `Cli -> Api 'Boots a local run via start(ctx)'` at the component level.
      serverSupervisor -> Switchboard.Api 'Supervises the imported start(ctx) over its dual ingress'

      // The docker bring-up drives Tailscale: userspace tailscaled, tailscale up, the pinned serve.
      dockerBringUp -> Tailscale 'Brings up userspace tailscaled, tailscale up (mounted auth key), and the pinned `tailscale serve` (>= v1.50.0)'
    }

    // Relationships that exist in the foundations skeleton today.
    WebSPA -> Api 'Calls over the typed Hono RPC client (TanStack Query)'
    Cli -> Api 'Boots a local run via start(ctx)'
  }

  // --- External systems ----------------------------------------------------

  GitHub = external 'GitHub' {
    description 'Remote git hosting and pull-request APIs (PAT-authenticated).'
  }

  TmuxHost = external 'Tmux Host' {
    description "The host's tmux sessions and the `claude` processes they run."
  }

  ClaudeBackplane = external 'Claude Backplane' {
    description "Claude's remote-control servers that drive `claude` sessions."
  }

  Tailscale = external 'Tailscale' {
    description 'Private mesh network. `tailscale serve` is the only ingress to the loopback-bound API.'
  }

  MobileApp = external 'Claude Mobile App' {
    description 'The official Claude mobile app (an alternative remote-control client).'
  }

  // --- Cross-boundary relationships ----------------------------------------

  // Network ingress: the API binds to loopback; serve is the exclusive front door. Realised by
  // runtime-cli-docker over the dedicated, non-host-published loopback serve port (the bind-time
  // identity-trust property), graduated from Planned/runtime-cli-docker.c4.
  Tailscale -> Api 'HTTPS/443 -> the dedicated loopback-TCP serve ingress (http://127.0.0.1:<servePort>); no API port is published to the host, so serve is the sole ingress'

  // Intended integrations — scaffolded in foundations, behaviour lands in changes 3–6.
  Api -> GitHub 'Clones repositories and reads/writes pull requests' {
    #planned
  }
  Api -> TmuxHost 'Supervises tmux sessions and `claude` processes' {
    #planned
  }

  // How `claude` sessions are actually driven.
  TmuxHost -> ClaudeBackplane '`claude` processes connect for remote control'
  MobileApp -> ClaudeBackplane 'Controls Claude sessions remotely'

  // User-facing deep link (graduated from link-claude-code-online): the web app opens the live
  // session on Claude Code for web.
  Switchboard.WebSPA -> ClaudeBackplane 'Deep-links the user to claude.ai/code/<bridge id> to remote-control the live session from the web'
}
