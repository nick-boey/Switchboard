// Switchboard architecture — base views (foundations).
//
// `foundations-context`    — system context (Switchboard + the external systems).
// `foundations-containers` — the containers inside Switchboard and their neighbours.

views {

  view foundations-context {
    title 'Foundations — System Context'

    include *
  }

  view foundations-containers of Switchboard {
    title 'Foundations — Containers'

    include *
  }

  // API components contributed by repo-clone-browse (graduated from its Planned overlay).
  view repo-clone-browse-api of Switchboard.Api {
    title 'repo-clone-browse — API components'

    include *
  }

  // API components contributed by worktree-management (graduated from its Planned overlay).
  view worktree-management-api of Switchboard.Api {
    title 'worktree-management — API components'

    include *
  }
}
