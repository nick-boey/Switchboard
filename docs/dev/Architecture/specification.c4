// Switchboard architecture — element & relationship vocabulary.
//
// This is the PERMANENT base specification (foundations, Decision 9 / plan.md
// "Planned architecture"). Element ids defined in `model.c4` are fixed here so later
// changes can `extend` them and graft `Planned/<change>.c4` `#todo` overlays.

specification {

  // --- Element kinds -------------------------------------------------------

  element system {
    style {
      shape rectangle
    }
  }

  element container {
    style {
      shape rectangle
      opacity 25%
    }
  }

  element external {
    style {
      shape rectangle
      color gray
    }
  }

  // Components live inside containers (e.g. the services inside `Switchboard.Api`),
  // graduated from the `Planned/<change>.c4` overlays as each change is built.
  element component {
    style {
      shape rectangle
      opacity 20%
    }
  }

  // --- Tags ----------------------------------------------------------------

  // `planned` marks parts of the skeleton that are scaffolded but whose behaviour
  // arrives in later changes (git/github/tmux services, changes 3–6).
  tag planned

  // `todo` marks elements/relationships authored by a `Planned/<change>.c4` overlay
  // ahead of (or alongside) build. Graduated here from repo-clone-browse's overlay so
  // the still-active overlays (worktree-management, claude-session-launch) keep resolving
  // it; removed once the last overlay graduates.
  tag todo
}
