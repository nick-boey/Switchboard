{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist-types",
    "rootDir": ".",
    "emitDeclarationOnly": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    ".storybook-prototypes/**/*.ts",
    ".storybook-prototypes/**/*.tsx"
  ],
  "exclude": ["dist", "dist-types", "storybook-static", "node_modules"],
  "references": [{ "path": "../../packages/shared" }, { "path": "../server" }]
}
