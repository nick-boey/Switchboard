# Copy to .env and fill in. .env is gitignored.
#
# Tailscale auth key: https://login.tailscale.com/admin/settings/keys
# For a throwaway spike, an *ephemeral* + *reusable* key is convenient (the node
# auto-removes when it goes offline). A tagged key (e.g. tag:spike) is tidier.
TS_AUTHKEY=

# Hostname the node registers as on your tailnet.
TS_HOSTNAME=switchboard-spike
